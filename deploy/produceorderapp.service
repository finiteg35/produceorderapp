[Unit]
Description=Produce Order App (Gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/produceorderapp
Environment=DATA_DIR=/opt/produceorderapp/data
ExecStart=/usr/bin/env gunicorn --bind 0.0.0.0:8000 --workers 2 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
