# Copy this file to .env and fill in your values for local development.
# On Render this is injected automatically via the render.yaml envVars section.

# PostgreSQL connection string.
# Render provides this automatically when a database is linked to the service.
# Example (local): postgresql://postgres:password@localhost:5432/produce_app
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: database connection timeout in seconds (default: 5).
# Increase this value on slow networks or if you see connection timeout errors.
# DB_CONNECT_TIMEOUT=5
