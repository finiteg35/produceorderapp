# Copy this file to .env and fill in your values for local development.
# On Render this is injected automatically via the render.yaml envVars section.

# Flask secret key – change this to a long random string in production.
FLASK_SECRET_KEY=change-me-in-production

# Admin portal credentials (default: admin / admin123 – change before deploying).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Designated email address to receive order spreadsheets.
# Leave empty to disable the "Email Spreadsheet" feature.
# ADMIN_EMAIL=orders@example.com

# SMTP settings for sending emails (order confirmations + spreadsheet emails).
# Leave SMTP_HOST empty to disable all email sending.
# Example using Gmail: set SMTP_HOST=smtp.gmail.com and use an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=you@example.com

# Path to the JSON file used for order persistence (default: orders.json).
# ORDERS_FILE=orders.json

